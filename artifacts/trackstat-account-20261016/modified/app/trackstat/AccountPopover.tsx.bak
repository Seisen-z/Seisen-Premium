"use client";
import { useEffect, useState } from 'react';
import Link from 'next/link';
import type { User } from '@supabase/supabase-js';
import { ChevronRight, LogOut, ShieldCheck, UserRound, Users, X } from 'lucide-react';
import { trackstatAuth, trackstatFetch } from '@/lib/client/trackstat-auth';
import { button } from './ui';

export default function AccountPopover({ count, onChange }: { count: number; onChange: (clear?: boolean) => void }) {
  const [user, setUser] = useState<User | null>(null);
  const [busy, setBusy] = useState(false);
  const [message, setMessage] = useState('');
  useEffect(() => {
    let live = true;
    void trackstatAuth.auth.getSession().then(({ data }) => { if (live) setUser(data.session?.user ?? null); });
    const { data: { subscription } } = trackstatAuth.auth.onAuthStateChange((event, session) => {
      if (live) { setUser(session?.user ?? null); setTimeout(() => { if (live) onChange(event === 'SIGNED_OUT'); }, 0); }
    });
    return () => { live = false; subscription.unsubscribe(); };
  }, [onChange]);
  async function signOut() {
    setBusy(true); setMessage('');
    try {
      const response = await trackstatFetch('/api/trackstat/profile', { method: 'DELETE' });
      if (!response.ok) throw new Error('Could not clear this browser connection.');
      const { error } = await trackstatAuth.auth.signOut({ scope: 'local' });
      if (error) throw error;
      onChange(true);
    } catch (error) { setMessage(error instanceof Error ? error.message : 'Sign out failed.'); }
    finally { setBusy(false); }
  }
  return <>
    <button popoverTarget="trackstat-account" className="flex w-full items-center gap-3 rounded-xl border border-white/10 bg-white/[0.025] p-3 text-left text-white/75 hover:border-[#c9a97a]/40" aria-label="Open Account">
      <span className="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-[#c9a97a]/10 text-[#c9a97a]"><UserRound size={17} /></span>
      <span className="flex-1 text-sm font-medium text-white">Account</span><ChevronRight size={14} />
    </button>
    <div id="trackstat-account" popover="auto" role="dialog" aria-labelledby="trackstat-account-title" className="fixed inset-auto bottom-4 left-4 m-0 w-[min(340px,calc(100vw-32px))] rounded-2xl border border-[#c9a97a]/25 bg-[#101010] p-5 text-white shadow-[0_24px_90px_#000a] md:left-[262px]">
      <div className="mb-5 flex items-center justify-between"><div className="flex items-center gap-2 text-[#c9a97a]"><ShieldCheck size={17} /><h2 id="trackstat-account-title" className="text-sm font-semibold">Account</h2></div><button popoverTarget="trackstat-account" popoverTargetAction="hide" aria-label="Close account panel" className="p-1 text-white/40 hover:text-white"><X size={17} /></button></div>
      <div className="space-y-4">
        <div><p className="mb-1 text-[10px] uppercase tracking-[0.18em] text-white/35">{user ? 'Verified email' : 'Browser account'}</p><p className="break-all text-sm">{user?.email ?? 'Not signed in'}</p></div>
        <div className="flex items-center gap-3 rounded-lg border border-white/[0.07] bg-white/[0.025] p-3"><Users size={19} className="text-[#c9a97a]" /><div className="flex-1 text-xs text-white/55">Connected Roblox accounts</div><span className="font-mono text-xl text-white">{count}</span></div>
        {user ? <button disabled={busy} onClick={() => void signOut()} className="flex items-center gap-2 text-xs text-white/50 hover:text-white"><LogOut size={14} />Sign out of this browser</button> : <Link href="/trackstat/login" className={`${button} block w-full text-center border-[#c9a97a]/40 bg-[#c9a97a]/10 text-[#c9a97a]`}>Sign in</Link>}
      </div>
      {message && <p role="status" className="mt-4 text-xs leading-6 text-[#d6bd98]">{message}</p>}
    </div>
  </>;
}
