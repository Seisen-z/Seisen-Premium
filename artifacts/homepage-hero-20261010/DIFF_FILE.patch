@@ -0,0 +1,55 @@
+.hero {
+  position: relative;
+  isolation: isolate;
+  overflow: hidden;
+  display: flex;
+  align-items: center;
+  min-height: max(720px, calc(100svh - var(--nav-height, 56px)));
+  background: #080808;
+}
+.art { position: absolute; inset: 0; z-index: -2; }
+.image { object-fit: cover; object-position: 63% center; }
+.shade {
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  pointer-events: none;
+  background: linear-gradient(90deg, #080808 0%, rgba(8,8,8,.98) 25%, rgba(8,8,8,.91) 40%, rgba(8,8,8,.50) 52%, rgba(8,8,8,.08) 69%, transparent 82%);
+}
+.content {
+  position: relative;
+  width: 50%;
+  padding: 72px 32px 72px clamp(72px, 6vw, 112px);
+}
+.badge {
+  position: absolute;
+  top: 36px;
+  right: 32px;
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  padding: 10px 15px;
+  border: 1px solid rgba(255,255,255,.16);
+  border-radius: 999px;
+  background: rgba(8,8,8,.86);
+  color: #f1f5f0;
+  font-size: 12px;
+  font-weight: 600;
+  backdrop-filter: blur(12px);
+}
+.badge span { width: 7px; height: 7px; border-radius: 50%; background: #6ee7b7; }
+@media (max-width: 1023px) {
+  .hero { display: flex; flex-direction: column; align-items: stretch; min-height: 0; }
+  .content { order: 1; width: 100%; padding: 56px 32px 12px; }
+  .content h1 { max-width: 700px; font-size: clamp(2.6rem, 7vw, 4.25rem) !important; }
+  .art { position: relative; order: 2; z-index: 0; height: clamp(280px, 56vw, 540px); }
+  .art::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg,#080808 0%,rgba(8,8,8,.5) 10%,transparent 33%); }
+  .image { object-position: right center; }
+  .shade { display: none; }
+  .badge { top: auto; bottom: 20px; right: auto; left: 24px; z-index: 1; }
+}
+@media (max-width: 480px) {
+  .content { padding: 44px 24px 8px; }
+  .content h1 { letter-spacing: -.045em !important; }
+  .art { height: 320px; }
+}

